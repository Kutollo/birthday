<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For Luyanda ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;600;700&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
-webkit-tap-highlight-color:transparent;
}

body{
font-family:'Inter',sans-serif;
background:black;
color:white;
overflow:hidden;
height:100vh;
}

/* ================= BACKGROUND ================= */

#bgVideo{
position:fixed;
inset:0;
width:100%;
height:100%;
object-fit:cover;
z-index:-3;
filter:brightness(0.25);
}

.overlay{
position:fixed;
inset:0;
background:
linear-gradient(
to bottom,
rgba(0,0,0,0.3),
rgba(0,0,0,0.82)
);
z-index:-2;
}

/* ================= LOADER ================= */

#loader{
position:fixed;
inset:0;
background:black;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
z-index:99999;
transition:1s;
}

#loader.hide{
opacity:0;
pointer-events:none;
}

.loader-heart{
font-size:60px;
animation:pulse 1.5s infinite;
}

.loader-text{
margin-top:20px;
font-size:13px;
letter-spacing:4px;
opacity:0.6;
}

@keyframes pulse{
0%{transform:scale(1);}
50%{transform:scale(1.15);}
100%{transform:scale(1);}
}

/* ================= EXPERIENCE ================= */

#experience{
width:100%;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
padding:20px;
position:relative;
}

/* ================= MAGAZINE ================= */

.magazine{
width:100%;
max-width:460px;
height:92vh;

background:
linear-gradient(
135deg,
rgba(255,255,255,0.14),
rgba(255,255,255,0.04)
);

backdrop-filter:blur(20px);

border:1px solid rgba(255,255,255,0.14);

border-radius:30px;

overflow:hidden;

position:relative;

box-shadow:
0 0 60px rgba(0,0,0,0.6);
}

/* ================= PAGES ================= */

.page{
position:absolute;
inset:0;

padding:32px 26px 110px;

display:flex;
flex-direction:column;
justify-content:flex-start;

opacity:0;
pointer-events:none;

transform:scale(1.04);

transition:
opacity 0.8s ease,
transform 0.8s ease;
}

.page.active{
opacity:1;
pointer-events:auto;
transform:scale(1);
}

/* ================= PAGE CONTENT ================= */

.page-label{
font-size:11px;
letter-spacing:4px;
opacity:0.5;
margin-bottom:16px;
}

.page-title{
font-family:'Cormorant Garamond',serif;
font-size:42px;
line-height:1;
margin-bottom:18px;
}

.page-text{
line-height:1.95;
font-size:14px;
white-space:pre-line;
opacity:0.92;
overflow-y:auto;
padding-right:4px;
}

/* HIDE SCROLLBAR */

.page-text::-webkit-scrollbar{
display:none;
}

/* ================= COVER ================= */

.cover-image{
width:100%;
border-radius:22px;
margin:18px 0 25px;

box-shadow:
0 10px 30px rgba(0,0,0,0.45);
}

.cover-sub{
font-size:14px;
line-height:1.8;
opacity:0.85;
margin-bottom:28px;
}

/* ================= MEDIA ================= */

.photo{
width:100%;
border-radius:20px;
margin-top:20px;

box-shadow:
0 10px 25px rgba(0,0,0,0.45);
}

video{
width:100%;
border-radius:20px;
margin-top:20px;
}

/* ================= BUTTONS ================= */

.controls{
position:absolute;
bottom:22px;
left:0;
width:100%;
display:flex;
justify-content:center;
gap:14px;
padding:0 20px;
}

button{
padding:14px 28px;
border:none;
border-radius:40px;
background:white;
color:black;
font-weight:600;
font-size:14px;
}

/* ================= MUSIC ================= */

.music-btn{
position:absolute;
top:18px;
right:18px;

width:48px;
height:48px;

border-radius:50%;

background:
rgba(255,255,255,0.12);

backdrop-filter:blur(10px);

border:1px solid rgba(255,255,255,0.12);

color:white;

font-size:18px;

z-index:999;
}

/* ================= HEARTS ================= */

.heart{
position:fixed;
bottom:-20px;
font-size:18px;
opacity:0.5;
pointer-events:none;
animation:floatUp linear forwards;
z-index:9999;
}

@keyframes floatUp{
to{
transform:translateY(-120vh);
opacity:0;
}
}

/* ================= FINAL PAGE ================= */

.final-title{
font-family:'Dancing Script',cursive;
font-size:58px;
text-align:center;
margin-top:40px;
margin-bottom:25px;
}

.final-text{
text-align:center;
line-height:2;
opacity:0.9;
}

/* ================= MOBILE ================= */

@media(max-width:480px){

.magazine{
height:94vh;
}

.page-title{
font-size:36px;
}

.final-title{
font-size:48px;
}

}

</style>
</head>

<body>

<!-- LOADER -->

<div id="loader">

<div class="loader-heart">❤️</div>

<div class="loader-text">
LOADING YOUR LOVE STORY
</div>

</div>

<!-- BACKGROUND -->

<video autoplay muted loop playsinline id="bgVideo">
<source src="cinematic.mp4" type="video/mp4">
</video>

<div class="overlay"></div>

<audio id="music" loop>
<source src="bg.mp3" type="audio/mp3">
</audio>

<!-- EXPERIENCE -->

<section id="experience">

<div class="magazine">

<button class="music-btn" id="musicBtn">
♫
</button>

<!-- PAGE 1 -->

<div class="page active">

<div class="page-label">
SPECIAL EDITION
</div>

<h1 class="page-title">
For Luyanda ❤️
</h1>

<p class="cover-sub">
A small interactive magazine made with love, memories, emotions, and all the words I never want you to forget.
</p>

<img src="IMG_2034.jpeg" class="cover-image">

<div class="page-text">
Made with love… just for you, my Luyanda 💗
</div>

</div>

<!-- PAGE 2 -->

<div class="page">

<div class="page-label">
PAGE 01
</div>

<h2 class="page-title">
Made with love… 💗
</h2>

<div class="page-text">
I made this to celebrate you on your birthday…

because you deserve to feel loved, appreciated, and special in every way.

I know I wasn’t there for the past two birthdays,
but I’m here now… and I want to make up for every moment I missed.

So take your time going through this…
it was all made with you in mind 💗
</div>

</div>

<!-- PAGE 3 -->

<div class="page">

<div class="page-label">
PAGE 02
</div>

<h2 class="page-title">
Before Anyone Else 🎈
</h2>

<div class="page-text">
I wanted to be the first to celebrate you… before anyone else gets the chance, so you’re seeing this a little earlier.
</div>

</div>

<!-- PAGE 4 -->

<div class="page">

<div class="page-label">
PAGE 03
</div>

<h2 class="page-title">
Happy Birthday 🩵
</h2>

<div class="page-text">
Tomorrow is going to be special… because it’s the day someone truly important came into this world. 🩵

I hope your birthday is filled with love, laughter, peace, and all the little things that make your heart feel light and happy. You deserve a day that feels as beautiful as the person you are.
</div>

<img src="IMG_2034.jpeg" class="photo">

</div>

<!-- PAGE 5 -->

<div class="page">

<div class="page-label">
PAGE 04
</div>

<h2 class="page-title">
Us 🥺
</h2>

<div class="page-text">
I’ve always had a soft spot for you… just as much as you’ve always had one for me.

No matter the time, distance, or everything that happened in between, that feeling never really disappeared.

Being able to talk to you again is honestly something I appreciate more than I probably say out loud.
</div>

</div>

<!-- PAGE 6 -->

<div class="page">

<div class="page-label">
PAGE 05
</div>

<h2 class="page-title">
A Promise 🤍
</h2>

<div class="page-text">
And I also want to apologize for how things ended between us before.

I don’t want to ruin such a beautiful moment by dwelling on the past, but I truly regret the way I handled things.

I’m grateful you gave me another chance to be part of your life again, and that somehow we found our way back to each other.
</div>

</div>

<!-- PAGE 7 -->

<div class="page">

<div class="page-label">
PAGE 06
</div>

<h2 class="page-title">
Never Again 🩵
</h2>

<div class="page-text">
I know I might be the last person who should be speaking about promises…

but I mean this with all my heart:

I will never take the chance you gave us for granted.

Hurting you again is something I never want to happen.
</div>

</div>

<!-- PAGE 8 -->

<div class="page">

<div class="page-label">
PAGE 07
</div>

<h2 class="page-title">
Her Moment 🎬
</h2>

<video controls>
<source src="luyanda.mp4" type="video/mp4">
</video>

</div>

<!-- PAGE 9 -->

<div class="page">

<div class="page-label">
PAGE 08
</div>

<h2 class="page-title">
Your Gift 🎁
</h2>

<div class="page-text">
I got you something small…

but it means so much more than it probably looks like. 🥹

I wanted to give you something you could keep close to you… something simple, but constant.

Something that quietly becomes part of your everyday life… and maybe reminds you, even in silence, that there’s someone thinking about you.

Not in a loud or overwhelming way… just something soft, steady, and real.

And every time you notice it on your wrist, I hope it brings you a little warmth… a quiet reminder that you are cared for, appreciated, valued, and deeply close to someone’s heart.

It’s honestly just something I felt was right for you.

I can’t wait to see how beautiful it looks on that cute hand of yours… 🥺

And I hope it never leaves your wrist… the same way you never really left my heart. 🩵
</div>

</div>

<!-- PAGE 10 -->

<div class="page">

<h1 class="final-title">
I Love You 🩵
</h1>

<div class="final-text">
More than anything, I just want your birthday to feel warm, unforgettable, and full of love.

Enjoy every second of it… because you deserve nothing less.
</div>

</div>

<!-- CONTROLS -->

<div class="controls">

<button onclick="prevPage()">
Previous
</button>

<button onclick="nextPage()">
Next
</button>

</div>

</div>

</section>

<script>

/* ================= LOADER ================= */

window.addEventListener("load",()=>{

setTimeout(()=>{
document.getElementById("loader").classList.add("hide");
},1800);

});

/* ================= MUSIC ================= */

const music=document.getElementById("music");

document.getElementById("musicBtn").onclick=function(){

if(music.paused){
music.play();
this.innerHTML="♫";
}else{
music.pause();
this.innerHTML="⏸";
}

};

/* ================= PAGES ================= */

const pages=document.querySelectorAll(".page");

let currentPage=0;

function showPage(index){

pages.forEach(page=>{
page.classList.remove("active");
});

pages[index].classList.add("active");

}

/* NEXT */

function nextPage(){

if(currentPage < pages.length-1){

currentPage++;

showPage(currentPage);

}

}

/* PREV */

function prevPage(){

if(currentPage > 0){

currentPage--;

showPage(currentPage);

}

}

/* ================= HEARTS ================= */

setInterval(()=>{

const heart=document.createElement("div");

heart.className="heart";

heart.innerHTML="❤️";

heart.style.left=Math.random()*100+"vw";

heart.style.animationDuration=
(4+Math.random()*4)+"s";

document.body.appendChild(heart);

setTimeout(()=>{
heart.remove();
},8000);

},900);

</script>

</body>
</html>
